<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/terminal_bg"
    android:clipToPadding="false"
    android:fitsSystemWindows="true"
    android:paddingBottom="24dp"
    android:paddingTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/settings_back_btn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:scaleType="centerInside"
                android:src="@drawable/ic_back_chip" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Alpiner"
                android:textColor="@color/terminal_text"
                android:textSize="26sp"
                android:textStyle="bold" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Font Size" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SettingsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6" />

                    <SeekBar
                        android:id="@+id/font_size_slider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:layout_weight="1"
                        android:max="24"
                        android:min="6"
                        android:progress="10" />

                    <TextView
                        style="@style/SettingsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingsSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terminal" />

                <TextView
                    style="@style/SettingsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scrollback lines" />

                <!-- Max is Prefs.SCROLLBACK_ROWS.size - 1 (index into that array). -->
                <SeekBar
                    android:id="@+id/scrollback_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:max="9"
                    android:progress="4" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SettingsLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Auto-hide extra keys" />

                    <Switch
                        android:id="@+id/autohide_keys_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingsSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Power" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wake lock" />

                        <TextView
                            style="@style/SettingsHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Keep running in background" />

                    </LinearLayout>

                    <Switch
                        android:id="@+id/wakelock_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Keep screen on" />

                        <TextView
                            style="@style/SettingsHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="While the terminal is visible" />

                    </LinearLayout>

                    <Switch
                        android:id="@+id/keep_screen_on_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <TextView
                    android:id="@+id/battery_opt_btn"
                    style="@style/SettingsButton"
                    android:layout_marginTop="8dp"
                    android:text="Disable battery optimization" />

                <TextView
                    android:id="@+id/crash_logs_btn"
                    style="@style/SettingsButton"
                    android:layout_marginTop="8dp"
                    android:text="Crash logs" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingsSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Extra keys" />

                <TextView
                    style="@style/SettingsHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Space-separated buttons. Tokens: ESC TAB CTRL ALT SHIFT INS DEL HOME END UP DOWN LEFT RIGHT MENU BACKSPACE. Anything else is typed as text." />

                <EditText
                    android:id="@+id/extra_keys_row1_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:drawable/edit_text"
                    android:hint="☰ ESC TAB CTRL ALT ▲ HOME END"
                    android:inputType="text"
                    android:textColor="@color/terminal_text"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/extra_keys_row2_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="⌨ INS DEL — ▶ ▼ ◀ /"
                    android:inputType="text"
                    android:textColor="@color/terminal_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/save_extra_keys_btn"
                    style="@style/SettingsButton"
                    android:layout_marginTop="12dp"
                    android:text="Save extra keys" />

                <TextView
                    android:id="@+id/reset_extra_keys_btn"
                    style="@style/SettingsButton"
                    android:layout_marginTop="8dp"
                    android:text="Reset extra keys" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/version_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:alpha="0.4"
            android:textColor="@color/terminal_text"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
