<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/terminalBg"
    android:fitsSystemWindows="true">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/terminalBg">

            <com.termux.view.TerminalView
                android:id="@+id/terminal_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:imeOptions="actionNone|flagNoEnterAction" />

            <LinearLayout
                android:id="@+id/split_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.termux.view.TerminalView
                    android:id="@+id/terminal_view_left"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:imeOptions="actionNone|flagNoEnterAction" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="?attr/dividerColor" />

                <com.termux.view.TerminalView
                    android:id="@+id/terminal_view_right"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:imeOptions="actionNone|flagNoEnterAction" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/quick_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="?attr/extraKeysBg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Quick Settings"
                        android:textColor="?attr/terminalText"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/panel_close"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✕"
                        android:textColor="?attr/terminalText"
                        android:textSize="16sp"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:paddingHorizontal="8dp">

                    <TextView
                        android:id="@+id/panel_wakelock"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Wake lock"
                        android:background="?attr/selectableItemBackground"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_margin="2dp" />

                    <TextView
                        android:id="@+id/panel_font_up"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="A+"
                        android:background="?attr/selectableItemBackground"
                        android:textSize="14sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_margin="2dp" />

                    <TextView
                        android:id="@+id/panel_font_down"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="A−"
                        android:background="?attr/selectableItemBackground"
                        android:textSize="14sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_margin="2dp" />

                    <TextView
                        android:id="@+id/panel_reset"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Reset"
                        android:background="?attr/selectableItemBackground"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_margin="2dp" />

                    <TextView
                        android:id="@+id/panel_split"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Split"
                        android:background="?attr/selectableItemBackground"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_margin="2dp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/dividerColor" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:gravity="center"
                    android:text="Swipe up to close"
                    android:textSize="10sp"
                    android:alpha="0.4" />

            </LinearLayout>

        </FrameLayout>

        <LinearLayout
            android:id="@+id/sessions_panel"
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:orientation="vertical"
            android:background="?attr/extraKeysBg"
            android:fitsSystemWindows="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="\u2630 Sessions"
                    android:textColor="?attr/terminalText"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/distro_size_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:gravity="end"
                    android:text=""
                    android:textColor="?attr/terminalText"
                    android:textSize="10sp"
                    android:alpha="0.5" />

                <TextView
                    android:id="@+id/session_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="12sp"
                    android:alpha="0.7" />

            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/session_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp" />

            </ScrollView>

            <TextView
                android:id="@+id/new_session_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:text="+ New Session"
                android:foreground="?attr/selectableItemBackground"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:gravity="center"
                android:background="?attr/extraKeysBg" />

        </LinearLayout>

    </androidx.drawerlayout.widget.DrawerLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="?attr/extraKeysBg"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/extra_keys_container"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="?attr/extraKeysBg"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/extra_keys_container_row2"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal" />

    </HorizontalScrollView>

</LinearLayout>
