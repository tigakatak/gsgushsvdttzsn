<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup/restore is disabled entirely: no cloud backup and no
    device-to-device transfer. domain="root" covers
    file/database/sharedpref/external in one rule.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
