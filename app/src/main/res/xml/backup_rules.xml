<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
        Cloud backup ke Google Drive dimatikan total (privasi + kuota):
        tidak ada byte RedT yang ter-upload ke infra Google.
        Device-to-device transfer saat pindah HP tetap aktif.
        domain="root" mencakup file/database/sharedpref/external sekaligus.
    -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="settings.xml" />
        <include domain="file" path="installed/" />
        <include domain="file" path="rootfs/" />
    </device-transfer>
</data-extraction-rules>
