<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="SettingsCard" parent="">
        <item name="cardBackgroundColor">@color/extra_keys_bg</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">16dp</item>
        <item name="android:layout_marginBottom">20dp</item>
    </style>

    <style name="SettingsSection" parent="">
        <item name="android:textColor">@color/terminal_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <style name="SettingsLabel" parent="">
        <item name="android:textColor">@color/terminal_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SettingsHint" parent="SettingsLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:alpha">0.6</item>
    </style>

    <style name="SettingsButton" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@color/terminal_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
